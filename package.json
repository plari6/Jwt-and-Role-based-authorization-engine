{
  "name": "jwt-rbac-engine",
  "version": "1.0.0",
  "description": "JWT & role-based authorization engine for multi-tenant SaaS apps: bcrypt passwords, rotating refresh tokens, Admin/Manager/User roles with own/team/tenant scopes, Express middleware, REST API and CLI.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "authz": "bin/authz.js"
  },
  "scripts": {
    "start": "node bin/authz.js serve",
    "demo": "node bin/authz.js demo",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "jwt",
    "rbac",
    "authorization",
    "authentication",
    "bcrypt",
    "express",
    "multi-tenant",
    "saas"
  ],
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "commander": "^14.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}

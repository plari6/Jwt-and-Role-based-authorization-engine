# Generated by `authz init` - set once, never change after users exist (stored passwords depend on it)
AUTHZ_PEPPER=
# Only for algorithm HS256 (min 32 bytes). ES256/RS256 use keys/keyset.json instead.
AUTHZ_HS_SECRET=
# Optional overrides of authz.config.json
# AUTHZ_ISSUER=https://auth.example.com
# AUTHZ_AUDIENCE=saas-api
# AUTHZ_ALGORITHM=ES256
# AUTHZ_ACCESS_TTL=15m
# AUTHZ_DB=./data/authz.db
# AUTHZ_KEYS_DIR=./keys
# AUTHZ_POLICY=./policy.json
# AUTHZ_BCRYPT_ROUNDS=12
# AUTHZ_TRUST_PROXY=1
# AUTHZ_ALLOW_SIGNUP=false
# AUTHZ_CORS_ORIGINS=https://app.example.com
# PORT=4000
